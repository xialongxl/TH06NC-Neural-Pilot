# Shell reference. Set values in the launching shell, for example $env:PYTHONUTF8 = '1'.
# 仅供参考。在启动进程的终端显式设置变量，例如 $env:PYTHONUTF8 = '1'。
# The application does not load .env files. Use config.json for game and safety settings.
# 项目不会自动加载 .env。游戏与保护设置放在 config.json。
PYTHONUTF8=1
PYTHONUNBUFFERED=1
# Optional CLI and legacy GUI locale. / 可选的命令行与旧界面语言。
# TH06AI_LANG=en
# install.ps1 sets an absolute project-local uv cache. / 安装脚本设置项目内 uv 缓存的绝对路径。
UV_CACHE_DIR=.cache/uv
